{
  "name": "epfo-claim-preflight",
  "version": "0.1.0",
  "private": true,
  "description": "EPFO Claim Pre-Flight — hackathon prototype for Build What Moves India. Independent, unaffiliated with EPFO. Uses simulated data only.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate:explanations": "node --env-file=.env.local scripts/generate-explanations.mjs",
    "generate:explanations:dry-run": "node --env-file=.env.local scripts/generate-explanations.mjs --dry-run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:prod": "PLAYWRIGHT_BASE_URL=https://buildwhatmovesindia-lemon.vercel.app playwright test"
  },
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  }
}
