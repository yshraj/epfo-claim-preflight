# Copy to .env.local and fill in ONLY if you want live LLM-generated
# explanations. The app works with zero keys set (LLM_PROVIDER=none),
# using canned local fallback text — no cost, no network calls.
#
# See docs/EPFO_Hackathon_Build_Plan.md and src/lib/llm/README.md for
# the full cost-minimization design: the LLM is only ever called by
# `npm run generate:explanations`, offline, to populate a static cache
# committed to the repo. The running app never calls a live provider.

# groq | openrouter | openai | none
LLM_PROVIDER=none

# --- Groq (recommended default — free tier, 14,400 requests/day, no card) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- OpenRouter (secondary/fallback — free tier is only 50 req/day) ---
# Get a key at https://openrouter.ai/keys
# Check https://openrouter.ai/models?max_price=0 for current :free model IDs —
# the free roster changes month to month.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- OpenAI (last resort — paid, off by default) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
